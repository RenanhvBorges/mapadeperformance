# CRM da Oxford (https://github.com/RenanhvBorges/crm). Com as duas variáveis
# preenchidas, todo lead é cadastrado lá e adicionado à lista "Leads - Mapa
# da performance digital". Sem elas, a isca funciona normalmente — só não
# cadastra ninguém.
CRM_API_URL=
CRM_API_KEY=

# Opcional. Sem isso usa a lista "Leads - Mapa da performance digital" que já
# existe no CRM (o UUID está fixo em api/lead.js). Só preencha se quiser
# apontar para outra lista.
CRM_LIST_ID=

# Opcional. URL que recebe o lead via POST (n8n, Make, Zapier, planilha).
# Sem isso o lead ainda aparece nos logs da Vercel e no CRM (se configurado).
LEAD_WEBHOOK_URL=

# O número de WhatsApp do CTA final NÃO fica aqui — ele é público de qualquer
# forma. Edite direto em app.js, no objeto CONFIG no topo do arquivo.
